# GhostPDF Environment Variables

# Storage backend: "local" (dev) or "r2" (production)
# On Vercel set this to "r2" — encrypted blobs go through presigned R2 URLs,
# which bypasses the 4.5MB serverless function body limit.
STORAGE_BACKEND=r2

# Database (PostgreSQL, e.g. Neon free tier)
# DATABASE_URL: pooled connection string for the app
# DIRECT_URL:   direct (non-pooled) connection string for Prisma migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ghostpdf?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ghostpdf?schema=public"

# Cloudflare R2 Storage (S3-compatible, free tier: 10GB, no egress fees)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="ghostpdf"

# Internal API Key (for cron jobs / cleanup)
INTERNAL_API_KEY="change-this-to-a-secure-random-string"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"